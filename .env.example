# SCOPE environment variables
# Copy this file to .env and fill in values. Never commit .env.

# Application
SCOPE_ENV=development
SCOPE_LOG_LEVEL=INFO
SCOPE_PROJECT_ROOT=.

# PostgreSQL (required; synchronous SQLAlchemy + psycopg 3)
SCOPE_DATABASE_URL=postgresql+psycopg://scope:scope@localhost:5432/scope

# API
SCOPE_API_HOST=127.0.0.1
SCOPE_API_PORT=8000

# LLM / RAG providers (add only when Phase 09+ requires them)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# EMBEDDING_MODEL=
